// Zone protection (dashboard, not automated): Security > WAF managed ruleset on, plus a rule that
// blocks every method but GET/OPTIONS except POST /admin/start. Turn on Bot Fight Mode, set Security
// Level to medium, and put the Worker on a custom domain: the Cache API is a no-op on workers.dev.
// Add an L7 DDoS override at high sensitivity if floods still reach the Worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pakt-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "PAKT_FACTORY": "pakt.pakt-0mxhjh.testnet",
    "NEARDATA_URL": "https://testnet.neardata.xyz",
    // empty = neardata, one call per block (needs FASTNEAR_API_KEY: keyless 429s); an rpc url (sandbox :3030) polls per tx
    "NEAR_RPC_URL": "",
    // first block when no cursor is stored; 0 = the final tip
    "START_HEIGHT": "277635748",
    // indexer never reads below this; raise it to skip a stretch with no pakt events
    "MIN_HEIGHT": "277635748",
    // upstream requests per minute; free rpc took 60 rapid calls unthrottled
    "UPSTREAM_PER_MIN": "600",
    // exact origins; `*` = one dns label, so vercel preview urls work. Add the custom domain once there is one
    "CORS_ORIGINS": "http://localhost:3000,https://paktdotfam.vercel.app,https://paktdotfam-*.vercel.app",
    // price relay, off while any is empty: {"<testnet token>": {"pyth": "<feed id hex>", "coingecko": "<coin id>", "coinbase": "<PAIR-USD>"}}
    "PRICE_MAP": "{\"tusdc.pakt-0mxhjh.testnet\":{\"pyth\":\"eaa020c61cc479712813461ce153894a96a6c00b21ed0cfc2798d1f9a9e9c94a\",\"coingecko\":\"usd-coin\",\"coinbase\":\"USDC-USD\"},\"tbtc.pakt-0mxhjh.testnet\":{\"pyth\":\"e62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43\",\"coingecko\":\"bitcoin\",\"coinbase\":\"BTC-USD\"},\"tnear.pakt-0mxhjh.testnet\":{\"pyth\":\"c415de8d2eba7db216527dff4b60e8f3a5311c740dadb233e13e12547e226750\",\"coingecko\":\"near\",\"coinbase\":\"NEAR-USD\"}}",
    "PRICE_ORACLE": "oracle.pakt-0mxhjh.testnet",
    "HERMES_URL": "https://hermes.pyth.network",
    "COINGECKO_URL": "https://api.coingecko.com",
    "COINBASE_URL": "https://api.coinbase.com",
    "TESTNET_RPC_URL": "https://rpc.testnet.fastnear.com",
    // faucet drip per request, raw units: 1000 tUSDC, 0.01 tBTC, 50 tNEAR; needs the FAUCET_SIGNER secret (pre-funded faucet account, not the owner), which also pays gas for POST /relay
    "FAUCET_DRIPS": "{\"tusdc.pakt-0mxhjh.testnet\":\"1000000000\",\"tbtc.pakt-0mxhjh.testnet\":\"1000000\",\"tnear.pakt-0mxhjh.testnet\":\"50000000000000000000000000\"}"
  },
  // FASTNEAR_API_KEY (optional secret): raises neardata/RPC limits. ADMIN_TOKEN guards POST /admin/start.
  // relay secrets (optional, `wrangler secret put`): ORACLE_REPORTER `account_id:ed25519:<secret>` signs
  // report_prices; HERMES_API_KEY (Pyth bearer key) switches the source from keyless CoinGecko to Hermes.
  "secrets": { "required": ["ADMIN_TOKEN"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "pakt", "database_id": "4d91ebfe-e7bb-4379-b398-787a24e81b14", "migrations_dir": "migrations" }
  ],
  "durable_objects": { "bindings": [{ "name": "INDEXER", "class_name": "Indexer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Indexer"] }],
  // daily: re-arms the indexer alarm if its chain ever dies. minutely: price relay
  "triggers": { "crons": ["0 3 * * *", "* * * * *"] },
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "4101", "simple": { "limit": 60, "period": 60 } },
    { "name": "STREAM_LIMIT", "namespace_id": "4102", "simple": { "limit": 10, "period": 60 } },
    { "name": "FAUCET_LIMIT", "namespace_id": "4103", "simple": { "limit": 1, "period": 60 } },
    // gas sponsor: a create or deposit flow posts a few delegates back to back
    { "name": "RELAY_LIMIT", "namespace_id": "4104", "simple": { "limit": 6, "period": 60 } }
  ]
}
